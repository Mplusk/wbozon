  "avito_get_orders": {
    "description": "Заказы своего кабинета, их состав, цены, статусы, трек-номера и пункты выдачи. Личные контакты покупателя и адрес курьерской доставки исключены.",
    "method": "GET",
    "path": "/order-management/1/orders",
    "query": [
      "ids",
      "statuses",
      "dateFrom",
      "page",
      "limit"
    ],
    "properties": {
      "ids": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 2048
        },
        "maxItems": 100,
        "description": "Идентификаторы заказов"
      },
      "statuses": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "on_confirmation",
            "ready_to_ship",
            "in_transit",
            "canceled",
            "delivered",
            "on_return",
            "in_dispute",
            "closed"
          ],
          "maxLength": 2048
        },
        "maxItems": 100,
        "description": "Статус, по которому нужно получить заказы. - on_confirmation - ожидает подтверждения - ready_to_ship - ждет отправки - in_transit - в пути - canceled - отменный заказ - delivered - доставлен покупателю - on_return - на возврате - in_dispute - по заказу открыт спор - closed - заказ закрыт"
      },
      "dateFrom": {
        "type": "integer",
        "description": "Метка времени, с момента которого созданы покупки"
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "description": "Номер страницы для пагинации"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "Максимальное количество заказов на странице",
        "default": 20
      }
    }
  },
