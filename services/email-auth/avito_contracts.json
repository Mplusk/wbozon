        "description": "Список ID объявлений. Формат значения: строка с идентификаторами объявлений на Авито, перечисленными через «,» или «|»."
      }
    },
    "required": [
      "query"
    ]
  },
  "avito_get_avito_ids_by_ad_ids": {
    "description": "Идентификаторы объявлений Авито по ID из файла автозагрузки.",
    "method": "GET",
    "path": "/autoload/v2/items/avito_ids",
    "query": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 2048,
        "description": "Список ID объявлений. Формат значения: строка с [идентификаторами объявлений из файла](https://autoload.avito.ru/format/realty/#Id), перечисленными через «,» или «|»"
      }
    },
    "required": [
      "query"
    ]
  },
  "avito_get_bbip_forecasts_by_items_v1": {
    "description": "Прогноз продвижения по объявлениям и выбранным параметрам.",
    "method": "POST",
    "path": "/promotion/v1/items/services/bbip/forecasts/get",
    "body": [
      "items"
    ],
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "itemId",
            "duration",
            "oldPrice",
            "price"
          ],
          "properties": {
            "duration": {
              "type": "integer"
            },
            "itemId": {
              "type": "integer",
              "format": "int64"
            },
            "oldPrice": {
              "type": "integer"
            },
            "price": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "description": "Данные по объявлениям для запроса прогноза"
      }
    },
    "required": [
      "items"
    ],
    "json_body": true
  },
  "avito_get_bbip_suggests_by_items_v1": {
    "description": "Рекомендации продвижения для указанных объявлений.",
    "method": "POST",
    "path": "/promotion/v1/items/services/bbip/suggests/get",
    "body": [
      "itemIds"
    ],
    "properties": {
      "itemIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "integer",
          "format": "int64"
        },
        "description": "Идентификаторы объявлений"
      }
    },
    "json_body": true
  },
  "avito_get_chat_by_id_v2": {
    "description": "Один чат и его последнее сообщение.",
    "method": "GET",
    "properties": {
      "chat_id": {
        "type": "string",
        "maxLength": 128,
        "description": "Идентификатор чата (клиента)"
      }
    },
    "path_params": [
      "chat_id"
    ],
    "path": "/messenger/v2/accounts/{user_id}/chats/{chat_id}",
    "required": [
      "chat_id"
    ]
  },
  "avito_get_chats_v2": {
    "description": "Чаты продавца по объявлениям и статусу прочтения. Авито по умолчанию возвращает чаты u2i. Чтобы получить все типы, укажите chat_types [\"u2i\", \"u2u\", \"a2u\"].",
    "method": "GET",
    "path": "/messenger/v2/accounts/{user_id}/chats",
    "query": [
      "item_ids",
      "unread_only",
      "chat_types",
      "limit",
      "offset"
    ],
    "properties": {
      "item_ids": {
        "type": "array",
        "items": {
          "type": "integer",
          "format": "int64"
        },
        "maxItems": 100,
        "description": "Получение чатов только по объявлениям с указанными item_id"
      },
      "unread_only": {
        "type": "boolean",
        "description": "При значении true метод возвращает только непрочитанные чаты"
      },
      "chat_types": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "u2i",
            "u2u",
            "a2u"
          ],
          "maxLength": 2048
        },
        "maxItems": 100,
        "description": "Фильтрация возвращаемых чатов. * u2i — чаты по объявлениям; * u2u — чаты между пользователями; * a2u — чаты между пользователями и Авито;"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "format": "int32",
        "description": "Количество сообщений / чатов для запроса",
        "default": 100
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000,
        "format": "int32",
        "description": "Сдвиг сообщений / чатов для запроса",
        "default": 0
      }
    }
  },
  "avito_get_courier_delivery_range": {
    "description": "Доступный временной интервал курьерской доставки для заказа.",
    "method": "GET",
    "path": "/order-management/1/order/getCourierDeliveryRange",
    "query": [
      "orderId",
