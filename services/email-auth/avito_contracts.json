  "avito_get_item_info": {
    "description": "Сведения об одном объявлении продавца.",
    "method": "GET",
    "properties": {
      "item_id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "description": "Идентификатор объявления на сайте"
      }
    },
    "path_params": [
      "item_id"
    ],
    "path": "/core/v1/accounts/{user_id}/items/{item_id}/",
