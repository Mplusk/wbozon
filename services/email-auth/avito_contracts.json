{
  "avito_account_spendings": {
    "description": "Расходы кабинета по периоду, типу расходов и группировке.",
    "method": "POST",
    "path": "/stats/v2/accounts/{user_id}/spendings",
    "body": [
      "dateFrom",
      "dateTo",
      "filter",
      "grouping",
      "spendingTypes"
    ],
    "properties": {
      "dateFrom": {
        "type": "string",
        "format": "date",
        "maxLength": 2048,
        "description": "Дата начала периода статистики расходов в формате YYYY-MM-DD"
      },
      "dateTo": {
        "type": "string",
        "format": "date",
        "maxLength": 2048,
        "description": "Дата конца периода статистики расходов в формате YYYY-MM-DD"
      },
      "filter": {
        "type": "object",
        "properties": {
          "categoryIDs": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "maxItems": 100
          },
          "itemIDs": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "maxItems": 100
          },
          "locationIDs": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "maxItems": 100
          }
        },
        "additionalProperties": false,
        "description": "Набор ограничений, по которым необходимо отфильтровать расходы"
      },
      "grouping": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month"
        ],
        "maxLength": 2048,
        "description": "Группировка статистики расходов (по дням, неделям, месяцам)"
      },
      "spendingTypes": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 2048
        },
        "maxItems": 100,
        "description": "Набор необходимых типов расходов"
      }
    },
    "required": [
      "dateFrom",
      "dateTo",
      "spendingTypes",
      "grouping"
    ],
    "json_body": true
  },
  "avito_get_ad_ids_by_avito_ids": {
