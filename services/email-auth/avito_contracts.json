        "type": "string",
        "maxLength": 2048,
        "description": "Поиск по одному или нескольким [идентификаторам объявлений из файла](https://www.avito.ru/autoload/documentation/templates/66940?fileFormat=xml#field-Id), перечисленным через «,» или «|». Без параметра — возвращаются все объявления с пагинацией."
      },
      "sections": {
        "type": "string",
        "maxLength": 2048,
        "description": "Фильтр по разделам отчёта. Формат значения: строка со slug разделов, перечисленными через запятую."
      },
      "perPage": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Количество объявлений на странице",
        "default": 20
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "description": "Номер страницы",
        "default": 1
      }
    }
  },
  "avito_get_dict_of_services_v1": {
