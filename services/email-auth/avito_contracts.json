    ],
    "properties": {
      "orderId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "description": "ID заказа"
      },
      "address": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "description": "Адрес продавца"
      }
    },
    "required": [
      "orderId"
    ]
  },
