    ]
  },
  "avito_get_items_info": {
    "description": "Страница объявлений своего кабинета с фильтрами по статусу и категории.",
    "method": "GET",
    "path": "/core/v1/items",
    "query": [
      "per_page",
      "page",
      "status",
      "updatedAtFrom",
      "category"
    ],
    "properties": {
      "per_page": {
        "type": "integer",
        "format": "int32",
        "minimum": 1,
        "maximum": 100,
        "description": "Количество записей на странице (целое число больше 0 и меньше 100)",
        "default": 25
      },
      "page": {
        "type": "integer",
        "format": "int32",
        "minimum": 1,
        "description": "Номер страницы (целое число больше 0)",
        "default": 1
      },
      "status": {
        "type": "string",
        "maxLength": 80,
        "description": "Статус объявления на сайте (можно указать несколько значений через запятую)",
        "pattern": "^(active|removed|old|blocked|rejected)(,(active|removed|old|blocked|rejected))*$"
      },
      "updatedAtFrom": {
        "type": "string",
        "maxLength": 2048,
        "format": "date",
        "description": "Фильтр больше либо равно по дате обновления/редактирования объявления в формате YYYY-MM-DD"
      },
      "category": {
        "type": "integer",
        "format": "int32",
        "description": "Идентификатор категории объявления</br> см. возможные варианты категорий в [ справочнике ](https://www.avito.st/s/openapi/catalog-categories.xml)"
      }
    }
  },
