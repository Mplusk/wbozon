  "avito_get_order_status_v1": {
    "description": "Статус заказа услуг продвижения.",
    "method": "POST",
    "path": "/promotion/v1/items/services/orders/status",
    "body": [
      "orderId"
    ],
    "properties": {
      "orderId": {
        "type": "string",
        "format": "uuid",
        "maxLength": 2048,
