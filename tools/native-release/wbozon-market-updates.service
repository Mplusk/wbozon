[Unit]
Description=Track changes to published marketplace API specifications
After=network-online.target marketplace-egress-tunnel.service
Wants=marketplace-egress-tunnel.service

[Service]
Type=oneshot
User=wbozon-schema
Group=wbozon-schema
StateDirectory=wbozon-market-updates
StateDirectoryMode=0700
RuntimeDirectory=wbozon-market-updates
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=true
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
Environment=HTTPS_PROXY=http://127.0.0.1:18761
Environment=NO_PROXY=127.0.0.1,localhost
ExecStart=/usr/bin/python3 -B -I /usr/local/libexec/wbozon-cd/market_updates.py
TimeoutStartSec=150
